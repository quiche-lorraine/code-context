{
    "name": "quiche-lorraine/code-context",
    "description": "CLI standalone qui génère un contexte de codebase (JSON + Markdown) destiné aux agents IA.",
    "type": "library",
    "license": "MIT",
    "require": {
        "php": ">=8.2",
        "ext-json": "*",
        "nikic/php-parser": "^5",
        "symfony/config": "^7 || ^8",
        "symfony/console": "^7 || ^8",
        "symfony/filesystem": "^7 || ^8",
        "symfony/finder": "^7 || ^8",
        "symfony/yaml": "^7 || ^8"
    },
    "autoload": {
        "psr-4": {
            "CodeContext\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "CodeContext\\Tests\\": "tests/"
        }
    },
    "require-dev": {
        "friendsofphp/php-cs-fixer": "^3.89",
        "phpstan/phpstan": "^2.1",
        "phpunit/phpunit": "^11.5"
    },
    "bin": [
        "bin/code-context"
    ],
    "config": {
        "sort-packages": true
    },
    "scripts": {
        "test": "phpunit -c phpunit.xml.dist",
        "lint": "phpstan analyse -c phpstan.neon",
        "fix": "php-cs-fixer fix --config=.php-cs-fixer.php"
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
